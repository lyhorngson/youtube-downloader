{
  "name": "youtube-downloader-mac",
  "version": "1.0.0",
  "description": "Modern YouTube Playlist & Video Downloader for macOS",
  "main": "electron.js",
  "type": "module",
  "scripts": {
    "server": "node --watch server.js",
    "client": "vite",
    "dev": "concurrently \"node --watch server.js\" \"vite\"",
    "start": "concurrently \"node --watch server.js\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  }
}
